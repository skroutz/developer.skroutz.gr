            { "reason": "damaged_packaging", "comment_required": true, "product_images_required": true, "packaging_images_required": true, "technical_assessment_report_required": false },
            { "reason": "partially_damaged_product", "comment_required": true, "product_images_required": true, "packaging_images_required": true, "technical_assessment_report_required": false },
            { "reason": "wrong_product_returned", "comment_required": true, "product_images_required": true, "packaging_images_required": false, "technical_assessment_report_required": false },
